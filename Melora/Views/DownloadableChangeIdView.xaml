<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Melora.Views.DownloadableChangeIdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlp="using:Melora.Helpers"
    xmlns:local="using:Melora.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdl="using:Melora.Models"
    xmlns:sys="using:System"
    x:Name="LyricsInfo"
    mc:Ignorable="d">

    <Grid MaxWidth="350">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Text="{x:Bind track.Id, Mode=TwoWay}" />
        <TextBlock
            Grid.Row="2"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Changing the track ID can result in mismatched metadata or failed downloads if an invalid ID is entered."
            TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
